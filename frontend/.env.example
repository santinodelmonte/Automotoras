# Copiar a .env.development (ignorado por git) y ajustar si hace falta.
# No a .env: Vite lo lee también en el build de producción, y el bundle quedaría
# apuntando a localhost. En producción la API está en el mismo origen.
# Base URL de la API. Debe coincidir con el perfil "http" de backend/Api/Properties/launchSettings.json
# y estar listada en Cors:AllowedOrigins del backend.
VITE_API_BASE_URL=http://localhost:5080
