{
  // Forma esperada de la configuración. Copiar a appsettings.Development.json
  // (ignorado por git) o exponer cada clave como variable de entorno.
  // Anidamiento por doble guion bajo: ConnectionStrings__Default, Jwt__Secret, etc.

  "ConnectionStrings": {
    // MySQL. En SmarterASP.NET la provee el panel de control.
    "Default": "Server=localhost;Port=3306;Database=automotora_saas;User Id=root;Password=CAMBIAR;"
  },

  "Jwt": {
    "Issuer": "automotora-saas",
    "Audience": "automotora-saas-clients",
    // Mínimo 32 bytes. Generar aleatorio, nunca versionar el valor real.
    "Secret": "CAMBIAR-por-una-clave-larga-y-aleatoria-de-al-menos-32-chars",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },

  "Storage": {
    // "Local" en desarrollo, "R2" en producción. Nunca se escribe en el disco
    // del servidor en producción: todo binario va a object storage.
    "Provider": "Local",
    // Solo para Provider=Local: carpeta fuera del repo donde guardar las imágenes.
    "LocalRootPath": "C:\\temp\\automotora-saas-uploads",
    // URL pública desde la que se sirven las imágenes.
    "PublicBaseUrl": "https://cdn.ejemplo.com",
    // Solo para Provider=R2 (S3-compatible).
    "Bucket": "automotora-saas",
    "Endpoint": "https://<account-id>.r2.cloudflarestorage.com",
    "AccessKeyId": "CAMBIAR",
    "SecretAccessKey": "CAMBIAR"
  },

  "Jobs": {
    // Valor esperado en el header X-Job-Secret de POST /api/jobs/{nombre}.
    // Los jobs periódicos los dispara un cron externo, no un BackgroundService:
    // el app pool de IIS recicla de forma impredecible.
    "Secret": "CAMBIAR-por-un-secreto-aleatorio"
  },

  "Seed": {
    // Contraseña de los usuarios de desarrollo. Solo se usa en Development, y solo si
    // está definida: sin valor, el seed no corre. Nunca hay una contraseña por defecto,
    // porque una contraseña por defecto que sobrevive a producción no la nota nadie
    // hasta que es tarde.
    "Password": "CAMBIAR-solo-para-desarrollo-1"
  },

  "Cors": {
    // Orígenes del frontend habilitados.
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
