{
  // Forma esperada de la configuración. Copiar a appsettings.Development.json
  // (ignorado por git) o exponer cada clave como variable de entorno.
  // Anidamiento por doble guion bajo: ConnectionStrings__Default, Jwt__Secret, etc.

  "ConnectionStrings": {
    // MySQL. En SmarterASP.NET la provee el panel de control.
    "Default": "Server=localhost;Port=3306;Database=automotora_saas;User Id=root;Password=CAMBIAR;"
  },

  // Versión del servidor con la que Pomelo genera el SQL, en su formato:
  // "8.0.36-mysql", "10.4.32-mariadb". Sin valor se asume MySQL 8, que es producción.
  // Hay que declararla en desarrollo si la base es MariaDB — es lo que trae XAMPP —:
  // las dos no hablan el mismo SQL.
  "Database": {
    "ServerVersion": "8.0.36-mysql"
  },

  "Jwt": {
    "Issuer": "automotora-saas",
    "Audience": "automotora-saas-clients",
    // Mínimo 32 bytes. Generar aleatorio, nunca versionar el valor real.
    "Secret": "CAMBIAR-por-una-clave-larga-y-aleatoria-de-al-menos-32-chars",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },

  "Storage": {
    // "Local" en desarrollo, "R2" en producción. Nunca se escribe en el disco
    // del servidor en producción: todo binario va a object storage.
    "Provider": "Local",
    // Solo para Provider=Local: carpeta fuera del repo donde guardar las imágenes.
    "LocalRootPath": "C:\\temp\\automotora-saas-uploads",
    // URL pública desde la que se sirven las imágenes, sin barra final.
    // Con Provider=Local, la sirve la propia API en /uploads.
    "PublicBaseUrl": "http://localhost:5080/uploads",
    // Solo para Provider=R2 (S3-compatible).
    "Bucket": "automotora-saas",
    "Endpoint": "https://<account-id>.r2.cloudflarestorage.com",
    "AccessKeyId": "CAMBIAR",
    "SecretAccessKey": "CAMBIAR"
  },

  "Jobs": {
    // Valor esperado en el header X-Job-Secret de POST /api/jobs/{nombre}.
    // Los jobs periódicos los dispara un cron externo, no un BackgroundService:
    // el app pool de IIS recicla de forma impredecible.
    "Secret": "CAMBIAR-por-un-secreto-aleatorio"
  },

  // IP públicas de la aplicación. Un dominio propio queda habilitado para servir el
  // sitio recién cuando resuelve a alguna de estas: apuntarlo acá requiere controlar su
  // DNS, que es la prueba de que quien lo cargó es su dueño. Sin valores, ningún dominio
  // se verifica — falla cerrado a propósito.
  "Deploy": {
    "IpsPublicas": [ "CAMBIAR-por-la-IP-del-hosting" ]
  },

  // Ciclo de cobro. Días de aviso antes del vencimiento y días de gracia después, con
  // el sitio público todavía arriba. Pasada la gracia, el sitio muestra mantenimiento.
  "Cobranza": {
    "DiasDeAviso": 7,
    "DiasDeGracia": 10
  },

  // Correo saliente para los avisos de vencimiento (POST /api/jobs/avisos-de-vencimiento).
  // Sin Host y Remitente los avisos no salen; el job lo informa y los reintenta en la
  // corrida siguiente a configurarlo.
  "Correo": {
    "Host": "smtp.CAMBIAR",
    "Puerto": 587,
    "UsarSsl": true,
    "Usuario": "CAMBIAR",
    "Password": "CAMBIAR",
    "Remitente": "avisos@CAMBIAR"
  },

  "Analitica": {
    // Cuántos meses se guarda el detalle de visitas y búsquedas. Lo más viejo lo borra el
    // job POST /api/jobs/limpieza-de-analitica. Ningún reporte mira más de un año.
    "MesesDeRetencion": 24
  },

  "Seed": {
    // Contraseña de los usuarios de desarrollo. Solo se usa en Development, y solo si
    // está definida: sin valor, el seed no corre. Nunca hay una contraseña por defecto,
    // porque una contraseña por defecto que sobrevive a producción no la nota nadie
    // hasta que es tarde.
    "Password": "CAMBIAR-solo-para-desarrollo-1"
  },

  // Solo para el primer arranque en una base de producción vacía: crea el SuperAdmin con
  // esta contraseña como provisoria. Si ya hay un SuperAdmin no hace nada. Se sacan
  // después del primer ingreso.
  "PrimerSuperAdmin": {
    "Email": "",
    "Password": ""
  },

  "Sentry": {
    // DSN del proyecto en sentry.io. Vacío apaga el reporte de errores: es lo normal en
    // desarrollo. En producción va por variable de entorno (Sentry__Dsn).
    "Dsn": "",
    // Sin trazas de rendimiento: solo errores. Con el plan gratuito alcanza y sobra.
    "TracesSampleRate": 0
  },

  "Cors": {
    // Orígenes del frontend habilitados.
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
